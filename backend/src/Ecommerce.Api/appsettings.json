{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "_comment_secrets": "ConnectionStrings:PostgreSql, Jwt:SigningKey, AdminSeed:Password, and Payments:WebhookSecret are intentionally absent here — see backend/SECRETS.md. Supply them via `dotnet user-secrets` in Development or environment variables (e.g. ConnectionStrings__PostgreSql) elsewhere. The app fails fast at startup if a required one is missing.",
  "Jwt": {
    "Issuer": "Ecommerce.Api",
    "Audience": "Ecommerce.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:3000" ]
  },
  "SerilogOptions": {
    "MinimumLevel": "Information",
    "LogFilePath": "logs/log-.txt",
    "RetainedFileCountLimit": 14
  },
  "Inventory": {
    "LowStockThreshold": 5
  },
  "DeliveryPricing": {
    "FreeDeliveryThreshold": 799,
    "FlatDeliveryFee": 40
  },
  "AdminSeed": {
    "Email": "admin@ecommerce.local",
    "FirstName": "System",
    "LastName": "Admin"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  }
}
