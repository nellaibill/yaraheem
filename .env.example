# Copy this file to .env and fill in real values before running `docker compose up -d --build`.
# .env is gitignored — never commit real secrets. See backend/SECRETS.md for what each value
# means and how to generate strong ones.

# ---- Public origin the app is served from ----
# Used both as the frontend's API base URL (nginx proxies /api and /health back to the api
# container, so the browser only ever talks to this one origin) and as the backend's CORS
# allow-list entry. Must be https:// — the backend refuses to start otherwise outside
# Development (see AddSharedCors). Put a TLS-terminating reverse proxy (Caddy, nginx+certbot,
# Cloudflare Tunnel, etc.) in front of this stack's "web" service — see DEPLOYMENT.md.
PUBLIC_ORIGIN=https://your-domain.example.com

# ---- Database ----
POSTGRES_DB=ecommerce_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# ---- Required app secrets ----
# openssl rand -base64 48
JWT_SIGNING_KEY=
# openssl rand -hex 32
PAYMENTS_WEBHOOK_SECRET=
ADMIN_SEED_EMAIL=admin@ecommerce.local
# Leave blank to skip seeding an admin account (you can set this and redeploy later — seeding
# is idempotent, skipped if the account already exists).
ADMIN_SEED_PASSWORD=

# ---- Optional integrations ----
# All of these can be left blank and configured later from Admin -> Integrations in the running
# app instead — see /admin/settings/integrations. Whichever source (here or the admin UI) has a
# value wins; the admin UI's database override takes precedence if both are set.
EMAIL_SMTP_HOST=
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
SMS_MSG91_API_KEY=
SMS_MSG91_TEMPLATE_ID=
SMS_MSG91_SENDER_ID=
WHATSAPP_TWILIO_ACCOUNT_SID=
WHATSAPP_TWILIO_AUTH_TOKEN=
WHATSAPP_TWILIO_FROM_NUMBER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Ports ----
# Host port the "web" container's nginx listens on. Point your reverse proxy at this.
WEB_PORT=80
